# Copy to .env.local (git-ignored). Never commit real values.
# Neon Postgres (pooled connection string)
DATABASE_URL=postgres://user:password@host/neondb?sslmode=require
# Neon Auth (Managed Better Auth) — from Neon Console > Auth > Configuration
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
# At least 32 characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=change-me-to-a-long-random-string-32+
# "neon" (default, real Neon Auth) or "local" (offline dev/tests only; refused on Vercel)
AUTH_MODE=neon
# Password given to seeded sample accounts by `npm run db:seed`
SEED_PASSWORD=
